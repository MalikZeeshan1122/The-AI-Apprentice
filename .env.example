# =====================================================================
# The AI Apprentice - Environment Secret Keys Configuration Template
# COPY THIS FILE TO .env AND PASTE YOUR ACTUAL SECRET KEYS
# =====================================================================

# ElevenLabs Voice API Key (for ElevenAgents & Scribe Realtime Voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI API Key (for Vision Model & Screen Event Extractor)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Alternative Vision & LLM Model)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Alternative LLM Model)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# FastAPI Server Port
PORT=8000
